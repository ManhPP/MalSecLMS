# Database
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=malsec_lms
DB_HOST_PORT=5432

# Backend HTTP and authentication
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_HOST_PORT=8000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://malsec.example.edu

# Initial empty-database seed and CSV imports
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-before-first-deploy
INITIAL_ADMIN_EMAIL=admin@example.edu
INITIAL_ADMIN_FULL_NAME=System Administrator
DEFAULT_STUDENT_PASSWORD=replace-with-an-initial-student-password

# Upload policy
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=png,jpg,jpeg,txt,log,pcap,pdf,zip
MALWARE_ZIP_PASSWORD=replace-with-the-course-zip-password

# Proxmox VE
PVE_API_HOST=proxmox.example.edu
PVE_API_USER=api-user@pve
PVE_TOKEN_NAME=malsec-api
PVE_TOKEN_VALUE=replace-with-the-proxmox-token-secret
PVE_NODE=pve-node-name
PVE_VERIFY_SSL=true
TEMPLATE_VMID_MIN=1000
TEMPLATE_VMID_MAX=2000
STUDENT_VMID_MIN=10000
STUDENT_VMID_MAX=19999
DEFAULT_TEMPLATE_VMID=1001
LAB_NETWORK_CIDR=10.30.0.0/24
VM_PROTOCOL_PORTS=rdp:3389,vnc:5900,ssh:22
DEFAULT_VM_PROTOCOL=rdp
VM_CLONE_TIMEOUT_SECONDS=900
VM_CONNECTION_TIMEOUT_SECONDS=180
VM_AGENT_TIMEOUT_SECONDS=180
VM_BOOT_WAIT_SECONDS=15
VM_VERIFY_CONNECTION=false

# Apache Guacamole encrypted JSON authentication
GUAC_BASE_URL=/guacamole/
GUAC_JSON_SECRET=replace-with-a-valid-guacamole-json-secret
GUAC_SESSION_TTL_SECONDS=86400
GUAC_RDP_SECURITY=any
GUAC_RDP_SERVER_LAYOUT=en-us-qwerty
GUAC_RDP_IGNORE_CERT=true
GUAC_RDP_ENABLE_WALLPAPER=true
GUAC_RDP_ENABLE_THEMING=true
GUAC_RDP_ENABLE_FONT_SMOOTHING=true
GUAC_RDP_ENABLE_FULL_WINDOW_DRAG=true
GUAC_RDP_ENABLE_MENU_ANIMATIONS=true
GUAC_RDP_ENABLE_DESKTOP_COMPOSITION=true
GUAC_SSH_IGNORE_HOST_KEY=true

# Frontend Nginx runtime
FRONTEND_HTTP_PORT=80
NGINX_LISTEN_PORT=80
NGINX_SERVER_NAME=_
BACKEND_UPSTREAM=http://backend:8000
GUAC_UPSTREAM=http://guacamole.example.edu:8080/guacamole/
CLIENT_MAX_BODY_SIZE=100M
PROXY_CONNECT_TIMEOUT=30s
PROXY_SEND_TIMEOUT=1000s
PROXY_READ_TIMEOUT=1000s

# Vite development/build configuration
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3000
VITE_API_PROXY_TARGET=http://backend:8000
VITE_API_PROXY_SECURE=false
